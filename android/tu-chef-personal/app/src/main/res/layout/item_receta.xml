<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_ingrediente"
    android:padding="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="3dp">

    <!-- Título y fecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🍽️"
            android:textSize="20sp"
            android:background="@drawable/bg_icono"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloReceta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#C75000" />

            <TextView
                android:id="@+id/tvFechaReceta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#999999"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Ingredientes usados -->
    <TextView
        android:id="@+id/tvIngredientesReceta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#666666" />

    <!-- Botones favorito y eliminar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnFavorito"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🤍"
            android:textSize="16sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#FF5252"
            android:paddingStart="0dp"
            android:paddingEnd="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnEliminarReceta"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="🗑️"
            android:textSize="16sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#888888"
            android:padding="0dp" />
    </LinearLayout>

</LinearLayout>